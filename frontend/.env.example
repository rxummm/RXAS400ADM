# 复制为 .env.development / .env.production 并按需修改
# 后端 API 代理目标（vite dev server 将 /api、/ws 转发到此处），默认 http://localhost:8080
VITE_API_PROXY_TARGET=http://localhost:8080
# 前端 axios 请求 baseURL，默认 /api/v1（走 vite 代理）
VITE_API_BASE=/api/v1
# 模块流程图 iframe 加载的 docs 站点地址（默认 http://localhost:5174，前端 dev 占 5173 时 docs 自动落 5174）
VITE_DOCS_URL=http://localhost:5174
