<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rxas400adm.system.mapper.SysRoleMenuMapper">

    <delete id="deleteByRoleId">
        DELETE FROM rx_role_menu WHERE role_id = #{roleId}
    </delete>

    <select id="selectMenuIdsByRoleId" resultType="long">
        SELECT menu_id FROM rx_role_menu WHERE role_id = #{roleId}
    </select>

    <insert id="insertBatch">
        INSERT INTO rx_role_menu (role_id, menu_id) VALUES
        <foreach item="menuId" collection="menuIds" separator=",">(#{roleId}, #{menuId})</foreach>
    </insert>

    <select id="selectMenuIdsByRoleIds" resultType="long">
        SELECT menu_id FROM rx_role_menu WHERE role_id IN
        <foreach item="id" collection="roleIds" open="(" separator="," close=")">#{id}</foreach>
    </select>

</mapper>